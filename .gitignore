# OS / editor noise
Thumbs.db
.DS_Store
*.swp
*~

# Build outputs. Root-scoped on purpose: bare `build/`/`dist/` patterns would
# also swallow BetterVencord/scripts/build/ (the esbuild pipeline — CI needs
# it!) and any nested dist/ that matters. (Nested node_modules/ stays ignored
# at every level; PyInstaller writes build//dist//release/ at the repo root.)
/dist/
/node_modules/
/build/
/release/
*.spec
pyinst.log
installer/payload/
__pycache__/
*.pyc

# Theme backups, if any land here
*.bak.*

# NOTE: Vencord's own .gitignore (BetterVencord/.gitignore) ignores
# src/userplugins/* but re-includes directories, so our plugin folders
# (all 10) ARE committed — `git add .` from the repo root picks them up.
